# Shared project settings
PROJECT_NAME=ethereum-land-registration-gas-analysis
NODE_ENV=development

# Local service ports
FRONTEND_PORT=5173
BACKEND_PORT=5000
MONGO_PORT=27017
GANACHE_PORT=8545

# MongoDB
MONGO_INITDB_ROOT_USERNAME=land_admin
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_DATABASE=land_registration_research

# Auth
JWT_SECRET=

# Optional SMTP delivery. When absent, email codes are shown in the local demo UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
